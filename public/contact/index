  <!-- Email -->
  <div class="contact-card">
    <a class="contact-link" href="mailto:runababy0813@outlook.com">
      <div class="contact-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </div>
      <div class="contact-info">
        <div class="contact-label">電子郵件</div>
        <div class="contact-value">runababykr@gmail.com</div>
